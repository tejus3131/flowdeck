# Copy this file to .env to get started. Every variable is declared and
# validated in env.ts — server vars are read from process.env at boot
# (never baked into any build artifact), VITE_-prefixed client vars are
# validated and baked into the bundle at build time (public by design;
# never put secrets there).

# ── local development (against the local Supabase stack) ──────────────
# These are the local development defaults printed by `supabase status`.
# The local stack has RLS too — the secret key below is the LOCAL one.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── web push (VAPID) — optional; blank disables browser notifications ──
# One keypair for ALL environments (identity continuity: subscriptions
# bind to the public key). Generate with:
#   node -e "const {generateKeyPairSync}=require('node:crypto');const {publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=publicKey.export({format:'jwk'});const x=Buffer.from(j.x,'base64url'),y=Buffer.from(j.y,'base64url');console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),x,y]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+privateKey.export({format:'jwk'}).d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@flowdeck.local

# ── email (Resend) — optional; blank falls back to copyable invite links ──
RESEND_API_KEY=
RESEND_FROM=Flowdeck <flowdeck@tejusgupta.dev>

# ── client (VITE_) — optional locally; the browser client no-ops without ──
VITE_APP_NAME=Flowdeck
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── preview MCP (shell env, NOT this file — .mcp.json references these) ──
# export FLOWDECK_PREVIEW_CF_ACCESS_CLIENT_ID=...
# export FLOWDECK_PREVIEW_CF_ACCESS_CLIENT_SECRET=...
# See docs/dev-setup.md.
