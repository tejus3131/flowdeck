# Copy this file to .env to get started; deploy platforms provide the real
# values as environment variables. Every variable is declared and validated
# in env.ts — server vars at boot (runtime process.env reads), VITE_-prefixed
# client vars at build time (baked into the bundle; never put secrets there).

# Supabase — against the local stack these are the local development
# defaults printed by `supabase status`. For production use the hosted
# project's keys from Settings → API. The secret key never reaches the
# client bundle (a build-time check blocks it if it tries).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Web push (VAPID) — generate once with the helper in AGENTS notes or keep blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@flowdeck.local
