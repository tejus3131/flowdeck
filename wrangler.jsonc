{
  // Solid start mode on Cloudflare Workers: the Cloudflare Vite plugin
  // resolves Solid's ssr environment to its Fetchable handler and runs it
  // in workerd (dev) / deploys it as the Worker (build). Static assets are
  // served by the platform from dist/client; everything else hits the
  // Solid handler.
  //
  // Environments (docs/ci-cd.md): the top level IS production (worker
  // `orbit`, prod Supabase); `env.preview` deploys as
  // `orbit-preview` with the preview project's URL. Client env
  // (VITE_*) is baked at build time — CI feeds the right values per
  // environment; nothing here holds secrets. Custom domains are attached
  // in the dashboard and survive deploys (deliberately not `routes`, so
  // deploys never fight the dashboard).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orbit",
  "main": "virtual:solid-ssr-handler",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "SUPABASE_URL": "https://ylarhvcbpppujpjnpxkq.supabase.co",
    // PostHog Cloud host for server-side flag evaluation (public API
    // endpoint; the project token is a wrangler secret — POSTHOG_KEY —
    // public-by-design but kept out of the repo like the Supabase
    // publishable key). See docs/posthog.md.
    "POSTHOG_HOST": "https://us.i.posthog.com",
  },
  "env": {
    "preview": {
      "name": "orbit-preview",
      "vars": {
        "SUPABASE_URL": "https://nopozruoekakakvwfpmh.supabase.co",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
    },
  },
}
