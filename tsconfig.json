{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },

  // The Supabase edge function runs on Deno (its own toolchain), and the
  // flowdeck-mcp CLI is a standalone package — neither belongs to the app
  // build.
  "exclude": ["supabase", "packages"]
}
